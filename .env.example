# Server-only transaction pooler (port 6543). Never expose to browser code.
DATABASE_URL=
# Direct or session-pooler connection for migrations, not transaction mode.
DIRECT_URL=
# Optional PEM certificate from Supabase when the database uses a private CA.
# Certificate validation is mandatory for remote runtime and migration connections.
DATABASE_SSL_CA=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Use the same exact origin for both (http://localhost:3000 for local development).
BETTER_AUTH_URL=
NEXT_PUBLIC_APP_URL=
# Optional until private documents are enabled. All are server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Required bucket name when Storage is configured: siteflow-documents
SUPABASE_STORAGE_BUCKET=
# One-time CLI bootstrap only. Use real details; remove after completion.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MOBILE=
BOOTSTRAP_CENTRE=
